$links = @{
    "4.5"   = "https://download.microsoft.com/download/1/4/3/1431F768-6099-4F82-B9F0-F56A42A1BA6D/dotnetfx45_full_x86_x64.exe"
    "4.5.1" = "https://download.microsoft.com/download/B/2/6/B26FB93F-98F1-4E4D-B509-89AB56B89D36/NDP451-KB2858728-x86-x64-AllOS-ENU.exe"
    "4.5.2" = "https://download.microsoft.com/download/4/8/E/48E15FF0-8CDB-46A7-9BC6-59489D88A2D3/NDP452-KB2901954-Web.exe"
    "4.7"   = "https://download.microsoft.com/download/6/0/F/60F5A94E-60F4-4E89-B4EE-3C60542EFCF1/NDP47-KB3186497-x86-x64-AllOS-ENU.exe"
    "4.8"   = "https://go.microsoft.com/fwlink/?linkid=2088631"  # Redireciona para a versão mais recente do 4.8
}

# Define o local de download
$downloadPath = "$env:TEMP\DotNetInstallers"
New-Item -ItemType Directory -Path $downloadPath -Force | Out-Null

# Função para baixar e instalar
function Install-DotNet {
    param (
        [string]$version,
        [string]$url
    )
    $installer = "$downloadPath\dotnet-$version.exe"

    Write-Host "Baixando .NET Framework $version..."
    Invoke-WebRequest -Uri $url -OutFile $installer

    Write-Host "Instalando .NET Framework $version..."
    Start-Process -FilePath $installer -ArgumentList "/quiet /norestart" -Wait
}

# Loop para baixar e instalar todas as versões
foreach ($version in $links.Keys) {
    Install-DotNet -version $version -url $links[$version]
}

Write-Host "Todas as versões do .NET Framework foram instaladas!" -ForegroundColor Green


